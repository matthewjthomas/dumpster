# Create a reusable or ephemeral auth key at:
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=dumpster

# User and group for uploaded files. Unraid uses nobody:users (99:100).
PUID=99
PGID=100

# Maximum size of one uploaded file, in MiB.
MAX_UPLOAD_MB=102400

# Host directory or mounted persistent volume that receives uploaded files. Maps to /data in the container.
DUMPSTER_STORAGE=./storage

# Optional: comma-separated Tailscale login emails. Empty allows all tailnet members.
ALLOWED_USERS=
